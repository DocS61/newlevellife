generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Name {
  id               Int      @id @default(autoincrement())
  name             String   @unique
  origin           String
  meaningDe        String   @map("meaning_de")
  meaningEn        String   @map("meaning_en")
  meaningEs        String   @map("meaning_es")
  gender           String
  region           String
  bullyingScore    Int      @map("bullying_score")
  intlScore        Int      @map("intl_score")
  careerScore      Int      @map("career_score")
  trendScore       Int      @map("trend_score")
  overallRegret    Int      @map("overall_regret")
  explanationDe    String   @map("explanation_de")
  explanationEn    String   @map("explanation_en")
  explanationEs    String   @map("explanation_es")
  popularity       Int      @default(50)
  yearPeak         Int?     @map("year_peak")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([region])
  @@index([overallRegret])
  @@index([popularity])
  @@map("names")
}
